PORT=3004

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tasks

# gRPC addresses
GRPC_URL=0.0.0.0:50058
AUTH_GRPC_URL=localhost:50051
USER_GRPC_URL=localhost:50056
PROJECT_GRPC_URL=localhost:50054

# used for the links in emails the task-service triggers
FRONTEND_URL=http://localhost:5173

# LLM for the AI task suggestions; without a key that endpoint answers 503
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# RabbitMQ (CloudAMQP)
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>
